# База данных PostgreSQL. Локально: `npm run db:local` поднимает встроенный Postgres на 54329.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/litmob
# Секрет Payload — длинная случайная строка (openssl rand -hex 32).
PAYLOAD_SECRET=change-me
# Публичный адрес сайта (canonical, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Объектное хранилище (Timeweb Cloud S3). Пусто — файлы пишутся на локальный диск.
S3_BUCKET=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Почта (SMTP, например RuSender SMTP). Пусто — письма не отправляются.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@litmob.ru
EMAIL_FROM_NAME=Литмоб

# Первый деплой: SEED_ON_START=1 создаёт структуру сайта и админа, потом убрать.
SEED_ON_START=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Подтверждение прав в поисковиках (код из мета-тега, только значение content).
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
